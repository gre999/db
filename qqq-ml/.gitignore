# Data: never commit raw or processed data
data/*
!data/raw/
!data/processed/
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Notebooks / OS / IDE
.ipynb_checkpoints/
.DS_Store
.vscode/
.idea/
